# Tech-Email-Digest-Automation — direnv wiring. NO secrets in this file.
# Names contract: .env.example. Values: .env (gitignored, operator-owned).

dotenv_if_exists .env

# Non-fatal warning while the operator restores .env — direnv stays usable.
if [ ! -s .env ]; then
  echo "direnv: .env is missing or empty — local runs (ingest, digest) need it." >&2
  echo "direnv: populate .env with the names from .env.example (the names contract), then run: direnv allow" >&2
  echo "direnv: required names: AZURE_TENANT_ID AZURE_CLIENT_ID AZURE_CLIENT_SECRET MAILBOX_USER TARGET_FOLDER_NAME OPENROUTER_API_KEY" >&2
fi
