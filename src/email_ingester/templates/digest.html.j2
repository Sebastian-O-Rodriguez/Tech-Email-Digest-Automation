<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 20px; background: #f5f5f5; color: #1a1a1a; }
  .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; }
  .header { background: #1a1a2e; color: #e0e0e0; padding: 20px 24px; }
  .header h1 { margin: 0 0 4px 0; font-size: 18px; font-weight: 600; }
  .header .meta { font-size: 12px; color: #999; }
  .section { padding: 12px 24px 4px 24px; }
  .section-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid; }
  .breaking .section-label { color: #c0392b; border-color: #c0392b; }
  .stacks .section-label { color: #2980b9; border-color: #2980b9; }
  .software .section-label { color: #27ae60; border-color: #27ae60; }
  .dives .section-label { color: #8e44ad; border-color: #8e44ad; }
  .section-body { font-size: 13px; line-height: 1.5; color: #333; margin: 0 0 8px 0; }
  .footnotes { padding: 12px 24px; border-top: 1px solid #eee; }
  .footnotes-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #666; margin: 0 0 8px 0; }
  .footnotes ol { margin: 0; padding: 0 0 0 20px; }
  .footnotes li { font-size: 12px; line-height: 1.6; color: #555; }
  .footnotes a { color: #2980b9; text-decoration: none; }
  .footnotes a:hover { text-decoration: underline; }
  .footer { padding: 12px 24px; text-align: center; font-size: 11px; color: #bbb; border-top: 1px solid #eee; }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <h1>Guava AI Daily Brief</h1>
    <div class="meta">{{ digest.generated_at.strftime('%B %d, %Y at %I:%M %p UTC') }} | {{ digest.total_processed }} source{{ 's' if digest.total_processed != 1 else '' }} analyzed</div>
  </div>

  {% if digest.report.breaking_news %}
  <div class="section breaking">
    <p class="section-label">Breaking News</p>
    <p class="section-body">{{ digest.report.breaking_news }}</p>
  </div>
  {% endif %}

  {% if digest.report.tech_stacks %}
  <div class="section stacks">
    <p class="section-label">Tech Stacks</p>
    <p class="section-body">{{ digest.report.tech_stacks }}</p>
  </div>
  {% endif %}

  {% if digest.report.new_software %}
  <div class="section software">
    <p class="section-label">New Software</p>
    <p class="section-body">{{ digest.report.new_software }}</p>
  </div>
  {% endif %}

  {% if digest.report.deep_dives %}
  <div class="section dives">
    <p class="section-label">Deep Dives</p>
    <p class="section-body">{{ digest.report.deep_dives }}</p>
  </div>
  {% endif %}

  {% if digest.report.footnotes %}
  <div class="footnotes">
    <p class="footnotes-label">Key Articles</p>
    <ol>
      {% for fn in digest.report.footnotes %}
      <li><a href="{{ fn.url }}">{{ fn.title }}</a></li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  <div class="footer">
    Guava AI Intelligence Brief
  </div>

</div>
</body>
</html>
