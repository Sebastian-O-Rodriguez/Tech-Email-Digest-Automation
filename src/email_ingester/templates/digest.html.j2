<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 20px; background: #f5f5f5; color: #1a1a1a; }
  .container { max-width: 640px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; }
  .header { background: #1a1a2e; color: #e0e0e0; padding: 20px 24px; }
  .header h1 { margin: 0 0 4px 0; font-size: 20px; font-weight: 600; }
  .header .meta { font-size: 13px; color: #999; }
  .section { padding: 16px 24px; }
  .section-title { font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0; padding-bottom: 8px; border-bottom: 2px solid; }
  .high .section-title { color: #c0392b; border-color: #c0392b; }
  .medium .section-title { color: #d4860b; border-color: #d4860b; }
  .item { margin-bottom: 16px; padding: 12px; background: #fafafa; border-radius: 6px; border-left: 3px solid #ddd; }
  .high .item { border-left-color: #c0392b; }
  .medium .item { border-left-color: #d4860b; }
  .item-subject { font-size: 15px; font-weight: 600; margin: 0 0 4px 0; }
  .item-sender { font-size: 12px; color: #888; margin: 0 0 8px 0; }
  .item-summary { font-size: 14px; line-height: 1.5; margin: 0 0 6px 0; }
  .item-why { font-size: 13px; color: #555; font-style: italic; margin: 0 0 6px 0; }
  .item-action { font-size: 13px; color: #2c3e50; margin: 0 0 8px 0; }
  .item-links { margin: 0; padding: 0; list-style: none; }
  .item-links li { font-size: 13px; margin: 2px 0; }
  .item-links a { color: #2980b9; text-decoration: none; }
  .item-links a:hover { text-decoration: underline; }
  .footer { padding: 16px 24px; text-align: center; font-size: 12px; color: #aaa; border-top: 1px solid #eee; }
  .low-summary { padding: 12px 24px; font-size: 13px; color: #888; }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <h1>Email Digest</h1>
    <div class="meta">{{ digest.generated_at.strftime('%B %d, %Y at %I:%M %p UTC') }} &middot; {{ digest.total_processed }} email{{ 's' if digest.total_processed != 1 else '' }} processed</div>
  </div>

  {% if digest.high_priority %}
  <div class="section high">
    <h2 class="section-title">High Priority ({{ digest.high_priority | length }})</h2>
    {% for item in digest.high_priority %}
    <div class="item">
      <p class="item-subject">{{ item.email.subject }}</p>
      <p class="item-sender">{{ item.email.sender }} &middot; {{ item.email.timestamp.strftime('%b %d, %I:%M %p UTC') }}</p>
      <p class="item-summary">{{ item.summary }}</p>
      <p class="item-why">{{ item.why_it_matters }}</p>
      <p class="item-action"><strong>Action:</strong> {{ item.recommended_action }}</p>
      {% if item.key_links %}
      <ul class="item-links">
        {% for link in item.key_links %}
        <li><a href="{{ link }}">{{ link | truncate(80) }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if digest.medium_priority %}
  <div class="section medium">
    <h2 class="section-title">Worth a Look ({{ digest.medium_priority | length }})</h2>
    {% for item in digest.medium_priority %}
    <div class="item">
      <p class="item-subject">{{ item.email.subject }}</p>
      <p class="item-sender">{{ item.email.sender }} &middot; {{ item.email.timestamp.strftime('%b %d, %I:%M %p UTC') }}</p>
      <p class="item-summary">{{ item.summary }}</p>
      {% if item.key_links %}
      <ul class="item-links">
        {% for link in item.key_links %}
        <li><a href="{{ link }}">{{ link | truncate(80) }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if digest.low_priority_count > 0 %}
  <div class="low-summary">
    {{ digest.low_priority_count }} low-priority email{{ 's' if digest.low_priority_count != 1 else '' }} skipped.
  </div>
  {% endif %}

  <div class="footer">
    Generated by Email Ingester
  </div>

</div>
</body>
</html>
