<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guava AI Digest</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; margin: 0; padding: 0; background: #f6f9fc; color: #1a1a1a; -webkit-font-smoothing: antialiased; }
  .wrapper { padding: 40px 20px; }
  .container { max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 12px; border: 1px solid #e8e8e8; overflow: hidden; }
  .brand { padding: 32px 32px 0 32px; }
  .brand-mark { font-size: 13px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #16a34a; margin: 0; }
  .header { padding: 12px 32px 24px 32px; border-bottom: 1px solid #eaeaea; }
  .header h1 { margin: 0 0 4px 0; font-size: 22px; font-weight: 700; color: #111; letter-spacing: -0.3px; }
  .header .meta { font-size: 12px; color: #8c8c8c; margin: 0; }
  .section { padding: 20px 32px 8px 32px; }
  .section-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 8px 0; padding: 4px 8px; border-radius: 4px; display: inline-block; }
  .breaking .section-label { color: #dc2626; background: #fef2f2; }
  .stacks .section-label { color: #2563eb; background: #eff6ff; }
  .software .section-label { color: #16a34a; background: #f0fdf4; }
  .dives .section-label { color: #7c3aed; background: #f5f3ff; }
  .section-body { font-size: 14px; line-height: 1.6; color: #374151; margin: 8px 0 0 0; }
  .divider { border: none; border-top: 1px solid #eaeaea; margin: 0; }
  .citations { padding: 20px 32px; }
  .citations-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #8c8c8c; margin: 0 0 10px 0; cursor: pointer; list-style: none; }
  .citations-label::-webkit-details-marker { display: none; }
  .citations-label::before { content: '\25B6  '; font-size: 9px; }
  details[open] > .citations-label::before { content: '\25BC  '; }
  .citations ul { margin: 0; padding: 0; list-style: none; }
  .citations li { font-size: 12px; line-height: 1.7; color: #6b7280; }
  .footer { padding: 20px 32px; text-align: center; border-top: 1px solid #eaeaea; }
  .footer p { margin: 0; font-size: 11px; color: #a3a3a3; }
  .footer .brand-footer { font-weight: 700; color: #16a34a; letter-spacing: 0.5px; }
</style>
</head>
<body>
<div class="wrapper">
<div class="container">

  <div class="brand">
    <p class="brand-mark">Guava AI</p>
  </div>

  <div class="header">
    <h1>{{ edition }} Digest</h1>
    <p class="meta">{{ digest.generated_at.strftime('%A, %B %d %Y') }} | {{ digest.total_processed }} source{{ 's' if digest.total_processed != 1 else '' }} analyzed</p>
  </div>

  {% if digest.report.breaking_news %}
  <div class="section breaking">
    <p class="section-label">Breaking News</p>
    <p class="section-body">{{ digest.report.breaking_news }}</p>
  </div>
  {% endif %}

  {% if digest.report.tech_stacks %}
  <div class="section stacks">
    <p class="section-label">Tech Stacks</p>
    <p class="section-body">{{ digest.report.tech_stacks }}</p>
  </div>
  {% endif %}

  {% if digest.report.new_software %}
  <div class="section software">
    <p class="section-label">New Software</p>
    <p class="section-body">{{ digest.report.new_software }}</p>
  </div>
  {% endif %}

  {% if digest.report.deep_dives %}
  <div class="section dives">
    <p class="section-label">Deep Dives</p>
    <p class="section-body">{{ digest.report.deep_dives }}</p>
  </div>
  {% endif %}

  {% if citations %}
  <hr class="divider">
  <div class="citations">
    <details>
      <summary class="citations-label">Works Cited</summary>
      <ul>
        {% for cite in citations %}
        <li>{{ cite }}</li>
        {% endfor %}
      </ul>
    </details>
  </div>
  {% endif %}

  <div class="footer">
    <p><span class="brand-footer">GUAVA AI</span></p>
  </div>

</div>
</div>
</body>
</html>
