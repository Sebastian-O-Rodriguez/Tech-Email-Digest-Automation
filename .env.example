# Microsoft Graph API (Azure AD App Registration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Target mailbox
MAILBOX_USER=user@example.com

# Outlook folder to ingest (display name)
TARGET_FOLDER_NAME=Inbox

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key

# LLM model (OpenRouter model ID)
LLM_MODEL=google/gemini-3.5-flash

# Digest recipient (defaults to MAILBOX_USER if not set)
DIGEST_RECIPIENT=
