# Microsoft Graph API (Azure AD App Registration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Target mailbox (the user whose emails to read/send)
MAILBOX_USER_ID=user@example.com

# Outlook folder to ingest (display name or folder ID)
MAILBOX_FOLDER=Inbox

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM model for summarization
LLM_MODEL=claude-sonnet-4-6-20250514

# Digest recipient (defaults to MAILBOX_USER_ID if not set)
DIGEST_RECIPIENT=

# State file path (relative to workspace)
STATE_FILE=state.json
